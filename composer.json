  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "ext-sodium": "*"
  },
  "autoload": {
    "psr-4": { "PrymeOperator\\": "src/" }
